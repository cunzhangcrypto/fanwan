{
  "name": "fanwaner",
  "version": "1.0.0",
  "private": true,
  "description": "没得饭吃啷个办？先把饭碗儿摆出来嘛。一个有点重庆味的开源在线饭碗儿。",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply fanwaner --local",
    "db:remote": "wrangler d1 migrations apply fanwaner --remote",
    "font:download": "node scripts/download-font.mjs",
    "font:upload": "node scripts/upload-font.mjs"
  },
  "devDependencies": {
    "cf-workers-og": "^3.0.1",
    "react": "^19.3.0",
    "wrangler": "^4.131.1"
  }
}
